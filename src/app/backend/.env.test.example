# Example Test Environment Configuration
# Copy this file to .env.test and supply local test database credentials.
# NEVER commit real credentials to version control.

NODE_ENV=test
PORT=5001

# Dedicated Disposable Test Database (Must end with _test and be pre-provisioned with test marker)
TEST_DATABASE_URL=postgres://[TEST_USER]:[TEST_PASSWORD]@[TEST_HOST]:5432/iqac_test
IS_DISPOSABLE_TEST_DB=true
ALLOW_DATABASE_RESET=true

# Isolated test cryptographic keys (ephemeral, not used in production)
JWT_SECRET=test_ephemeral_jwt_secret_min_32_chars_long_placeholder
JWT_EXPIRE=2h

# Client origin for test environment
CLIENT_URL=http://localhost:5173
