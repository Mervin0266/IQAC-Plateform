# ==============================================================================
# Environment Configuration Template — CHRIST University IQAC Platform Backend
# Copy to .env for local development. Set in Render Dashboard for Staging/Production.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL / Supabase / Render Postgres)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
DATABASE_URL=postgres://postgres:password@localhost:5432/iqac_db

# Enforce SSL encryption for remote cloud databases (set to 'true' for Supabase / Render)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Connection Pool Tuning
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Cryptographically secure random secret, minimum 32 characters
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters_long
JWT_EXPIRE=7d

# Reverse Proxy Trust (Set to 1 or true when deployed behind Render / Cloudflare reverse proxy)
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins (Comma-separated)
# ------------------------------------------------------------------------------
# Local dev: http://localhost:5173,http://localhost:3000
# Staging: https://iqac-staging.vercel.app
# Production: https://iqac.christuniversity.in,https://iqac-platform.vercel.app
CLIENT_URL=http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 5. Database Initialization (DEVELOPMENT ONLY — strictly ignored in production)
# ------------------------------------------------------------------------------
ENABLE_AUTO_SEED=false

# ------------------------------------------------------------------------------
# 6. Scopus / Elsevier CiteScore Integration (Optional - Backend only)
# ------------------------------------------------------------------------------
ELSEVIER_API_KEY=

