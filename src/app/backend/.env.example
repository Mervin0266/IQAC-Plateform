# Server Configuration
PORT=5000
NODE_ENV=production

# Database Settings (Provided by Render PostgreSQL or other Postgres host)
DATABASE_URL=postgres://user:password@host:5432/dbname
DB_SSL=true

# Security Settings
JWT_SECRET=replace_with_a_long_random_secret_minimum_32_characters
JWT_EXPIRE=7d

# CORS Client Origin (Your Vercel deployment URL, comma-separated if multiple)
CLIENT_URL=https://your-frontend-app.vercel.app
