# ==============================================================================
# Environment Configuration Template — CHRIST University IQAC Platform (Root)
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vercel & Local Vite Dev)
# ------------------------------------------------------------------------------
# Local dev: http://localhost:5000
# Staging: https://iqac-platform-backend-staging.onrender.com
# Production: https://iqac-backend.onrender.com (or custom api.christuniversity.in)
VITE_API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# Backend Docker Compose Environment Variables (Local Development)
# ------------------------------------------------------------------------------
PORT=5000
DATABASE_URL=postgres://postgres:password@host.docker.internal:5432/iqac_db
DB_SSL=false
JWT_SECRET=dev_jwt_secret_must_be_minimum_32_characters_long_for_security
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Scopus / Elsevier CiteScore Integration (Optional - Backend only)
# ------------------------------------------------------------------------------
ELSEVIER_API_KEY=

